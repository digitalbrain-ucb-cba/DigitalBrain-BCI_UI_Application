<Application x:Class="DigitalBrain.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DigitalBrain.UI.ViewModels"
             xmlns:views="clr-namespace:DigitalBrain.UI.Views">
    <Application.Resources>
        <ResourceDictionary>
            <!-- El tema (Styles/Themes/Light.xaml o Dark.xaml) lo añade ThemeService al iniciar. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Cada ViewModel de pantalla se muestra con su vista -->
            <DataTemplate DataType="{x:Type vm:CaptureViewModel}">
                <views:CaptureView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrainingViewModel}">
                <views:TrainingView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
