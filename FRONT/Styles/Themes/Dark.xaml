    <SolidColorBrush x:Key="SidebarActiveMutedBrush" Color="#A7AFBA" />

    <SolidColorBrush x:Key="Channel1Brush" Color="#8FB0C8" />
    <SolidColorBrush x:Key="Channel2Brush" Color="#D9876B" />
    <SolidColorBrush x:Key="Channel3Brush" Color="#D9DEE6" />
    <SolidColorBrush x:Key="Channel4Brush" Color="#D9B25A" />
    <SolidColorBrush x:Key="ValidSamplesBrush" Color="#9DB3C6" />
</ResourceDictionary>
