<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema oscuro: mismas claves que Light.xaml -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12171D" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A2028" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A323D" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#222A34" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2E3744" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#C8664A" />
