    <SolidColorBrush x:Key="TrackBrush" Color="#2E3744" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2A323D" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECE6DA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A7AFBA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7A838F" />
    <SolidColorBrush x:Key="SectionLabelBrush" Color="#9DB3C6" />

    <SolidColorBrush x:Key="AccentBrush" Color="#C8664A" />
