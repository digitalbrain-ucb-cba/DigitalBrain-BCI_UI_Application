    <!-- Recursos que no cambian con el tema. Los colores de superficie y de canal
         están en Styles/Themes/Light.xaml y Dark.xaml, que ThemeService intercambia. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="StatusIdleBrush" Color="#D8DCE2" />
    <SolidColorBrush x:Key="StatusActiveBrush" Color="#5FBF84" />

