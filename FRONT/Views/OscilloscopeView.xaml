<UserControl x:Class="DigitalBrain.UI.Views.OscilloscopeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DigitalBrain.UI.ViewModels"
             xmlns:controls="clr-namespace:DigitalBrain.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OscilloscopeViewModel}"
             d:DesignWidth="1300" d:DesignHeight="1400">

    <UserControl.Resources>
        <!-- Colores de los gráficos: llegan del tema para que cambien al instante -->
        <Style x:Key="PlotBaseStyle" TargetType="controls:PlotElement">
            <Setter Property="PlotBackground" Value="{DynamicResource ScopeBackgroundBrush}" />
            <Setter Property="GridBrush" Value="{DynamicResource ScopeGridBrush}" />
            <Setter Property="GridMajorBrush" Value="{DynamicResource ScopeGridMajorBrush}" />
            <Setter Property="TextBrush" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="AccentBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="DeltaBrush" Value="{DynamicResource BandDeltaBrush}" />
            <Setter Property="ThetaBrush" Value="{DynamicResource BandThetaBrush}" />
            <Setter Property="AlphaBrush" Value="{DynamicResource BandAlphaBrush}" />
            <Setter Property="BetaBrush" Value="{DynamicResource BandBetaBrush}" />
            <Setter Property="GammaBrush" Value="{DynamicResource BandGammaBrush}" />
        </Style>
        <Style TargetType="controls:OscilloscopeDisplay" BasedOn="{StaticResource PlotBaseStyle}">
            <Setter Property="Channel1Brush" Value="{DynamicResource Channel1Brush}" />
            <Setter Property="Channel2Brush" Value="{DynamicResource Channel2Brush}" />
            <Setter Property="Channel3Brush" Value="{DynamicResource Channel3Brush}" />
            <Setter Property="Channel4Brush" Value="{DynamicResource Channel4Brush}" />
            <Setter Property="SaturationBrush" Value="{DynamicResource SaturationBrush}" />
        </Style>
        <Style TargetType="controls:SpectrumButterfly" BasedOn="{StaticResource PlotBaseStyle}" />
        <!-- Con clave: dentro de un DataTemplate, WPF no aplica estilos implícitos a elementos que no son Control -->
        <Style x:Key="BandBarStyle" TargetType="controls:BandPowerBar" BasedOn="{StaticResource PlotBaseStyle}">
            <Setter Property="PlotBackground" Value="{DynamicResource TrackBrush}" />
        </Style>

        <!-- Texto sobre la pantalla vacía; se oculta si no hay texto -->
        <Style x:Key="OverlayTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TileValueStyle}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="16.5" />
        </Style>

        <Style x:Key="BandPercentStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Tarjeta de medidas de un canal: el color llega por Tag para poder usar DynamicResource -->
        <DataTemplate x:Key="ChannelMetricsTemplate" DataType="{x:Type vm:ScopeChannelViewModel}">
            <Border Style="{StaticResource CardStyle}" Padding="20,18">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DominantBandText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SectionLabelBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="11" Height="11" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,9,0"
                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <UniformGrid Columns="2" Margin="-4,12,-4,0">
                        <Border Style="{StaticResource TileStyle}" Margin="4" ToolTip="Valor eficaz de los últimos 2 s de señal filtrada">
                            <StackPanel>
                                <TextBlock Text="RMS" Style="{StaticResource TileLabelStyle}" />
                                <TextBlock Text="{Binding RmsText}" Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TileStyle}" Margin="4" ToolTip="Diferencia entre el máximo y el mínimo de los últimos 2 s">
                            <StackPanel>
                                <TextBlock Text="PICO A PICO" Style="{StaticResource TileLabelStyle}" />
                                <TextBlock Text="{Binding PeakToPeakText}" Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TileStyle}" Margin="4" ToolTip="Frecuencia de mayor amplitud entre 1 y 45 Hz">
                            <StackPanel>
                                <TextBlock Text="DOMINANTE" Style="{StaticResource TileLabelStyle}" />
                                <TextBlock Text="{Binding DominantText}" Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TileStyle}" Margin="4"
                                ToolTip="Amplitud de la red eléctrica en la señal sin filtrar. Si es alta, revisa el contacto del electrodo y la referencia.">
                            <StackPanel>
                                <TextBlock Text="RED ELÉCTRICA" Style="{StaticResource TileLabelStyle}" />
                                <TextBlock Text="{Binding MainsText}" Style="{StaticResource MetricValueStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="POTENCIA POR BANDA" Style="{StaticResource TileLabelStyle}" Margin="0,14,0,8" />
                    <controls:BandPowerBar Style="{StaticResource BandBarStyle}" Height="10" Shares="{Binding BandShares}" />
                    <UniformGrid Columns="5" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="δ" Style="{StaticResource BandPercentStyle}" Foreground="{DynamicResource BandDeltaBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding BandItems[0].PercentText}" Style="{StaticResource BandPercentStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="θ" Style="{StaticResource BandPercentStyle}" Foreground="{DynamicResource BandThetaBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding BandItems[1].PercentText}" Style="{StaticResource BandPercentStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="α" Style="{StaticResource BandPercentStyle}" Foreground="{DynamicResource BandAlphaBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding BandItems[2].PercentText}" Style="{StaticResource BandPercentStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="β" Style="{StaticResource BandPercentStyle}" Foreground="{DynamicResource BandBetaBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding BandItems[3].PercentText}" Style="{StaticResource BandPercentStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="γ" Style="{StaticResource BandPercentStyle}" Foreground="{DynamicResource BandGammaBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding BandItems[4].PercentText}" Style="{StaticResource BandPercentStyle}" />
                        </StackPanel>
                    </UniformGrid>

                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PulseCountText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Pulsos detectados" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding LastPulseText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            <DockPanel Margin="0,8,0,0"
                                       ToolTip="Fracción de muestras de este canal en ±800 µV desde que empezó la señal. El amplificador satura si el electrodo pierde contacto.">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SaturationText}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSaturating}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Saturación" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,36,40,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel>
                <TextBlock Text="DIAGNÓSTICO · SEÑAL EN VIVO" Style="{StaticResource SectionLabelStyle}" />
                <TextBlock Text="Osciloscopio" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,4" />
                <TextBlock Text="Comprueba los electrodos antes de grabar: forma de onda, pulsos, espectro (FFT) y potencia por banda de los cuatro canales."
                           FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Fuente de señal y control -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,24,0,0" Padding="28,22">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="FUENTE DE SEÑAL" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10" />
                            <ListBox Style="{StaticResource SegmentedStyle}" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Width="340"
                                     HorizontalAlignment="Left" />
                            <DockPanel Margin="0,12,0,0" Visibility="{Binding IsRecordingSource, Converter={StaticResource BoolToVisibility}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButtonStyle}" Margin="10,0,0,0"
                                        Command="{Binding BrowseRecordingCommand}" ToolTip="Elegir una grabación .txt" />
                                <TextBox Style="{StaticResource InputStyle}" Tag="Grabación .txt" IsReadOnly="True"
                                         Text="{Binding RecordingPath, Mode=OneWay}" ToolTip="{Binding RecordingPath}" />
                            </DockPanel>
                            <TextBlock Text="{Binding SourceHint}" Style="{StaticResource HintTextStyle}" />
                        </StackPanel>

                        <!-- Indicadores -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                            <Border Style="{StaticResource TileStyle}" Width="118" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="TIEMPO" Style="{StaticResource TileLabelStyle}" />
                                    <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource MetricValueStyle}" FontSize="20" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}" Width="158" Margin="0,0,10,0"
                                    ToolTip="Muestras recibidas por segundo. Debe coincidir con la frecuencia de muestreo de Inicio.">
                                <StackPanel>
                                    <TextBlock Text="VELOCIDAD" Style="{StaticResource TileLabelStyle}" />
                                    <TextBlock Text="{Binding RateText}" Style="{StaticResource MetricValueStyle}" FontSize="16" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}" Width="100">
                                <StackPanel>
                                    <TextBlock Text="PULSOS" Style="{StaticResource TileLabelStyle}" />
                                    <TextBlock Text="{Binding PulseTotalText}" Style="{StaticResource MetricValueStyle}" FontSize="20"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource OutlineButtonStyle}" Command="{Binding TogglePauseCommand}" Margin="0,0,12,0" MinWidth="130"
                                    IsEnabled="{Binding IsRunning}" ToolTip="Congela la pantalla; la señal se sigue recibiendo">
                                <TextBlock Text="{Binding PauseText}" />
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleRunCommand}" MinWidth="150">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentForegroundBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource IconPlayFilled}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconStopFilled}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding ToggleText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Message}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DeviceStatus}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Osciloscopio y ajustes -->
            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="22,20">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScaleText}" FontFamily="{StaticResource MonoFont}" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Forma de onda" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="0,0,20,0" />
                                <CheckBox Style="{StaticResource ChannelToggleStyle}" Content="CH-A" Tag="{DynamicResource Channel1Brush}" Margin="0,0,8,0"
                                          IsChecked="{Binding Channels[0].IsVisible}" ToolTip="Mostrar u ocultar el canal A" />
                                <CheckBox Style="{StaticResource ChannelToggleStyle}" Content="CH-B" Tag="{DynamicResource Channel2Brush}" Margin="0,0,8,0"
                                          IsChecked="{Binding Channels[1].IsVisible}" ToolTip="Mostrar u ocultar el canal B" />
                                <CheckBox Style="{StaticResource ChannelToggleStyle}" Content="CH-C" Tag="{DynamicResource Channel3Brush}" Margin="0,0,8,0"
                                          IsChecked="{Binding Channels[2].IsVisible}" ToolTip="Mostrar u ocultar el canal C" />
                                <CheckBox Style="{StaticResource ChannelToggleStyle}" Content="CH-D" Tag="{DynamicResource Channel4Brush}"
                                          IsChecked="{Binding Channels[3].IsVisible}" ToolTip="Mostrar u ocultar el canal D" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock Text="{Binding TriggerStatus}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding IsTriggerMode, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,4,0,0">
                                <Run Text="{Binding FilterSummary, Mode=OneWay}" />
                                <Run Text="Las franjas rojas marcan saturación (±800 µV) y los triángulos, pulsos detectados." />
                            </TextBlock>
                        </StackPanel>

                        <Grid MinHeight="460">
                            <controls:OscilloscopeDisplay Frame="{Binding ScopeFrame}" />
                            <TextBlock Text="{Binding OverlayText}" Style="{StaticResource OverlayTextStyle}" Margin="74,0,0,24" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Ajustes -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="24,20" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="AJUSTES" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,2" />

                        <TextBlock Text="MODO" Style="{StaticResource FieldLabelStyle}" />
                        <ListBox Style="{StaticResource SegmentedStyle}" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />

                        <UniformGrid Columns="2" Margin="-5,0">
                            <StackPanel Margin="5,0">
                                <TextBlock Text="TIEMPO" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Style="{StaticResource ComboStyle}" FontSize="15" ItemsSource="{Binding TimeBases}" SelectedItem="{Binding SelectedTimeBase}" />
                            </StackPanel>
                            <StackPanel Margin="5,0">
                                <TextBlock Text="AMPLITUD" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Style="{StaticResource ComboStyle}" FontSize="15" ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}" />
                            </StackPanel>
                        </UniformGrid>

                        <!-- Disparo -->
                        <StackPanel Visibility="{Binding IsTriggerMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="DISPARO POR PULSO" Style="{StaticResource SectionLabelStyle}" Margin="0,22,0,0" />
                            <TextBlock Text="CANAL" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Style="{StaticResource ComboStyle}" FontSize="15" ItemsSource="{Binding TriggerChannels}"
                                      SelectedItem="{Binding SelectedTriggerChannel}" />
                            <TextBlock Text="SENSIBILIDAD" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Style="{StaticResource ComboStyle}" FontSize="15" ItemsSource="{Binding Sensitivities}"
                                      SelectedItem="{Binding SelectedSensitivity}" />
                            <Button Style="{StaticResource OutlineButtonStyle}" Command="{Binding RearmTriggerCommand}" Margin="0,14,0,0"
                                    Padding="16,9" FontSize="15" HorizontalAlignment="Left" Content="Esperar el siguiente pulso" />
                        </StackPanel>

                        <TextBlock Text="FILTROS" Style="{StaticResource SectionLabelStyle}" Margin="0,22,0,0" />
                        <TextBlock Text="PASA ALTOS" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Style="{StaticResource ComboStyle}" FontSize="15" ItemsSource="{Binding HighPassOptions}" SelectedItem="{Binding SelectedHighPass}"
                                  ToolTip="Quita la continua y la deriva lenta de los electrodos" />
                        <UniformGrid Columns="2" Margin="-5,0">
                            <StackPanel Margin="5,0">
                                <TextBlock Text="NOTCH (RED)" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Style="{StaticResource ComboStyle}" FontSize="15" ItemsSource="{Binding NotchOptions}" SelectedItem="{Binding SelectedNotch}"
                                          ToolTip="Elimina la interferencia de la red eléctrica (50 Hz en Bolivia)" />
                            </StackPanel>
                            <StackPanel Margin="5,0">
                                <TextBlock Text="PASA BAJOS" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Style="{StaticResource ComboStyle}" FontSize="15" ItemsSource="{Binding LowPassOptions}" SelectedItem="{Binding SelectedLowPass}"
                                          ToolTip="Quita el ruido muscular y de alta frecuencia" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,14,0,0"
                                   Text="Los filtros solo afectan a esta pantalla: las grabaciones y el modelo usan la señal original." />
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="Un pulso es una muestra que se aleja de la mediana más de k·σ, con σ estimada por la MAD de los últimos 2 s: el umbral se adapta al ruido de cada electrodo." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Espectro -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,24,0,0" Padding="24,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ResolutionText}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Espectro de frecuencias (FFT)" Style="{StaticResource CardTitleStyle}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,14"
                               Text="Amplitud (µV) de cada frecuencia en los últimos 4 s, coloreada por banda. El triángulo marca la frecuencia dominante de cada canal." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border Width="11" Height="11" CornerRadius="3" Background="{DynamicResource Channel1Brush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="CH-A" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Channels[0].DominantText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Channels[1].DominantText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="CH-B" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border Width="11" Height="11" CornerRadius="3" Background="{DynamicResource Channel2Brush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <controls:SpectrumButterfly Height="340" Frame="{Binding SpectrumAB}" />
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border Width="11" Height="11" CornerRadius="3" Background="{DynamicResource Channel3Brush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="CH-C" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Channels[2].DominantText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Channels[3].DominantText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="CH-D" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border Width="11" Height="11" CornerRadius="3" Background="{DynamicResource Channel4Brush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <controls:SpectrumButterfly Height="340" Frame="{Binding SpectrumCD}" />
                        </DockPanel>
                    </Grid>

                    <!-- Leyenda de bandas -->
                    <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource BandDeltaBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="δ Delta" FontWeight="SemiBold" /><Run Text=" 0,5–4 Hz" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource BandThetaBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="θ Theta" FontWeight="SemiBold" /><Run Text=" 4–8 Hz" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource BandAlphaBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="α Alfa" FontWeight="SemiBold" /><Run Text=" 8–13 Hz" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource BandBetaBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="β Beta" FontWeight="SemiBold" /><Run Text=" 13–30 Hz" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource BandGammaBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="γ Gamma" FontWeight="SemiBold" /><Run Text=" ≥ 30 Hz" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Medidas por canal -->
            <UniformGrid Grid.Row="4" Columns="4" Margin="-9,24,-9,0">
                <ContentControl Margin="9,0" Content="{Binding Channels[0]}" Tag="{DynamicResource Channel1Brush}"
                                ContentTemplate="{StaticResource ChannelMetricsTemplate}" Focusable="False" />
                <ContentControl Margin="9,0" Content="{Binding Channels[1]}" Tag="{DynamicResource Channel2Brush}"
                                ContentTemplate="{StaticResource ChannelMetricsTemplate}" Focusable="False" />
                <ContentControl Margin="9,0" Content="{Binding Channels[2]}" Tag="{DynamicResource Channel3Brush}"
                                ContentTemplate="{StaticResource ChannelMetricsTemplate}" Focusable="False" />
                <ContentControl Margin="9,0" Content="{Binding Channels[3]}" Tag="{DynamicResource Channel4Brush}"
                                ContentTemplate="{StaticResource ChannelMetricsTemplate}" Focusable="False" />
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
