<Window x:Class="DigitalBrain.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DigitalBrain.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="{Binding Title}" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Contenedor dinámico para renderizar las vistas según el prototipo -->
        <ContentControl Content="{Binding CurrentView}" />
    </Grid>
</Window>
