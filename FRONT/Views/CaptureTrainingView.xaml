<UserControl x:Class="DigitalBrain.UI.Views.CaptureTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DigitalBrain.UI.ViewModels"
             xmlns:controls="clr-namespace:DigitalBrain.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CaptureTrainingViewModel}"
             d:DesignWidth="1200" d:DesignHeight="1000">

    <UserControl.Resources>
        <!-- Tarjeta de canal: el color llega por Tag para poder usar DynamicResource -->
        <DataTemplate x:Key="ChannelCardTemplate" DataType="{x:Type vm:ChannelViewModel}">
            <Border Style="{StaticResource CardStyle}" Padding="20,16" Height="156">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" FontFamily="{StaticResource MonoFont}" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Ellipse Width="9" Height="9" Margin="10,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                        </StackPanel>
                    </DockPanel>
                    <controls:SignalTrace Margin="0,12,0,4" Samples="{Binding Samples}" Range="{Binding Range}"
                                          Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                          BaselineBrush="{DynamicResource TrackBrush}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ValidityTileTemplate" DataType="{x:Type vm:ChannelViewModel}">
            <Border Style="{StaticResource CardStyle}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{Binding ValidTitle}" Style="{StaticResource TileLabelStyle}" />
                    <ProgressBar Style="{StaticResource ThinProgressStyle}" Margin="0,10,0,10" Value="{Binding ValidRatio, Mode=OneWay}"
                                 Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                    <TextBlock Text="{Binding ValidText}" FontSize="19" FontWeight="Bold"
                               Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="RecordingTileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RecordingTileCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RecordingTileLabel" TargetType="TextBlock" BasedOn="{StaticResource TileLabelStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,36,40,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel>
                <TextBlock Text="PASOS 1 Y 2 · MÓDULO DE ADQUISICIÓN" Style="{StaticResource SectionLabelStyle}" />
                <TextBlock Text="Captura y entrenamiento" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,4" />
                <TextBlock Text="Graba sesiones con ConDumpAuto.exe y entrena el modelo con ellas." FontSize="18"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="448" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna izquierda -->
                <StackPanel>
                    <!-- Configuración de sesión -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBool}}">
                            <TextBlock Text="CONFIGURACIÓN DE SESIÓN" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,-4" />

                            <TextBlock Text="SUJETO" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource InputStyle}" Tag="Ej. SUJ_001"
                                     Text="{Binding SubjectId, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="MOVIMIENTO / CLASE" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Style="{StaticResource ComboStyle}" ItemsSource="{Binding Movements}"
                                      SelectedItem="{Binding SelectedMovement}" DisplayMemberPath="DisplayName" />

                            <TextBlock Text="NÚMERO DE SESIÓN" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding SessionNumberText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="DURACIÓN (SEGUNDOS)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Duración total que recibe --seconds; los primeros 6 s no se guardan." />

                            <TextBlock Text="NOTAS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Style="{StaticResource InputStyle}" Tag="Condiciones, observaciones…" MinHeight="62"
                                     VerticalContentAlignment="Top" Padding="14,12" AcceptsReturn="True" TextWrapping="Wrap"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="RUTA CONDUMPAUTO.EXE" Style="{StaticResource FieldLabelStyle}" Margin="0,22,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButtonStyle}" Margin="10,0,0,0"
                                        Command="{Binding BrowseExecutableCommand}" ToolTip="Buscar el ejecutable" />
                                <TextBox Style="{StaticResource InputStyle}" Tag="ConDumpAuto.exe"
                                         Text="{Binding ExecutablePath, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{Binding ExecutablePath}" />
                            </DockPanel>

                            <TextBlock Text="CARPETA DE SALIDA" Style="{StaticResource FieldLabelStyle}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButtonStyle}" Margin="10,0,0,0"
                                        Command="{Binding BrowseOutputFolderCommand}" ToolTip="Elegir carpeta" />
                                <TextBox Style="{StaticResource InputStyle}" Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Relativa a la carpeta BACK" />
                            </DockPanel>

                            <TextBlock Margin="0,12,0,0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                <Run Text="Se guardará como" />
                                <Run Text="{Binding FileNamePreview, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Parámetros avanzados -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="PARÁMETROS AVANZADOS" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,14" />
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource TileStyle}" Margin="0,0,5,10">
                                    <StackPanel>
                                        <TextBlock Text="FRECUENCIA" Style="{StaticResource TileLabelStyle}" />
                                        <TextBlock Text="{Binding FrequencyText}" Style="{StaticResource TileValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileStyle}" Margin="5,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="VENTANA" Style="{StaticResource TileLabelStyle}" />
                                        <TextBlock Text="{Binding WindowText}" Style="{StaticResource TileValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileStyle}" Margin="0,0,5,10">
                                    <StackPanel>
                                        <TextBlock Text="AVANCE" Style="{StaticResource TileLabelStyle}" />
                                        <TextBlock Text="{Binding StepText}" Style="{StaticResource TileValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileStyle}" Margin="5,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="SOLAPAMIENTO" Style="{StaticResource TileLabelStyle}" />
                                        <TextBlock Text="{Binding OverlapText}" Style="{StaticResource TileValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileStyle}" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="SATURACIÓN" Style="{StaticResource TileLabelStyle}" />
                                        <TextBlock Text="{Binding SaturationText}" Style="{StaticResource TileValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileStyle}" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CANALES" Style="{StaticResource TileLabelStyle}" />
                                        <TextBlock Text="{Binding ChannelsText}" Style="{StaticResource TileValueStyle}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Columna derecha -->
                <StackPanel Grid.Column="2">
                    <!-- Señales -->
                    <UniformGrid Columns="2">
                        <ContentControl Margin="0,0,10,18" Content="{Binding Channels[0]}" Tag="{DynamicResource Channel1Brush}"
                                        ContentTemplate="{StaticResource ChannelCardTemplate}" Focusable="False" />
                        <ContentControl Margin="10,0,0,18" Content="{Binding Channels[1]}" Tag="{DynamicResource Channel2Brush}"
                                        ContentTemplate="{StaticResource ChannelCardTemplate}" Focusable="False" />
                        <ContentControl Margin="0,0,10,18" Content="{Binding Channels[2]}" Tag="{DynamicResource Channel3Brush}"
                                        ContentTemplate="{StaticResource ChannelCardTemplate}" Focusable="False" />
                        <ContentControl Margin="10,0,0,18" Content="{Binding Channels[3]}" Tag="{DynamicResource Channel4Brush}"
                                        ContentTemplate="{StaticResource ChannelCardTemplate}" Focusable="False" />
                    </UniformGrid>

                    <!-- Validez por canal -->
                    <UniformGrid Columns="4">
                        <ContentControl Margin="0,0,9,0" Content="{Binding Channels[0]}" Tag="{DynamicResource Channel1Brush}"
                                        ContentTemplate="{StaticResource ValidityTileTemplate}" Focusable="False" />
                        <ContentControl Margin="9,0,9,0" Content="{Binding Channels[1]}" Tag="{DynamicResource Channel2Brush}"
                                        ContentTemplate="{StaticResource ValidityTileTemplate}" Focusable="False" />
                        <ContentControl Margin="9,0,9,0" Content="{Binding Channels[2]}" Tag="{DynamicResource Channel3Brush}"
                                        ContentTemplate="{StaticResource ValidityTileTemplate}" Focusable="False" />
                        <ContentControl Margin="9,0,0,0" Content="{Binding Channels[3]}" Tag="{DynamicResource Channel4Brush}"
                                        ContentTemplate="{StaticResource ValidityTileTemplate}" Focusable="False" />
                    </UniformGrid>

                    <!-- Grabación -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,22,0,0" Padding="28,24">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding RecordingState, Mode=OneWay}" />
                                    <Run Text="{Binding RecordingFile, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                                <TextBlock Text="Grabación" Style="{StaticResource CardTitleStyle}" />
                            </DockPanel>

                            <WrapPanel Margin="0,18,0,0">
                                <Border Style="{StaticResource TileStyle}" Padding="20,10" MinWidth="128" Margin="0,0,14,8">
                                    <StackPanel>
                                        <TextBlock Text="TIEMPO" Style="{StaticResource RecordingTileLabel}" />
                                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource RecordingTileValue}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource RecordingTileCaption}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileStyle}" Padding="20,10" MinWidth="128" Margin="0,0,14,8">
                                    <StackPanel>
                                        <TextBlock Text="MUESTRAS VÁLIDAS" Style="{StaticResource RecordingTileLabel}" />
                                        <TextBlock Text="{Binding ValidSamplesText}" Style="{StaticResource RecordingTileValue}"
                                                   Foreground="{DynamicResource ValidSamplesBrush}" />
                                        <TextBlock Text="sin saturar" Style="{StaticResource RecordingTileCaption}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileStyle}" Padding="20,10" MinWidth="128" Margin="0,0,28,8">
                                    <StackPanel>
                                        <TextBlock Text="DESCARTADAS" Style="{StaticResource RecordingTileLabel}" />
                                        <TextBlock Text="{Binding DiscardedText}" Style="{StaticResource RecordingTileValue}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding SaturationText}" Style="{StaticResource RecordingTileCaption}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Button Style="{StaticResource OutlineButtonStyle}" Command="{Binding TrainModelCommand}" Margin="0,0,14,0" MinWidth="200">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Entrenar modelo" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTraining}" Value="True">
                                                            <Setter Property="Text" Value="Entrenando…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleCaptureCommand}" MinWidth="200">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentForegroundBrush}"
                                                  VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconPlayFilled}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource IconStopFilled}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Iniciar captura" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                                <Setter Property="Text" Value="Detener captura" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Message}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Últimas grabaciones -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,22,0,0" Padding="28,24">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="{Binding ViewAllText}"
                                        Command="{Binding OpenRecordingsCommand}" VerticalAlignment="Center" ToolTip="Abrir la carpeta de datos" />
                                <TextBlock Text="Últimas grabaciones" Style="{StaticResource CardTitleStyle}" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding RecentRecordings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RecordingItemViewModel}">
                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="2.4*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="0.6*" />
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="9" Height="9" Fill="{Binding AccentHex}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontFamily="{StaticResource MonoFont}" FontSize="16"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullPath}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding MovementName}" FontSize="16" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="16"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                    <Run Text="{Binding ValidCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Run Text="válidas" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="5" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                    <Run Text="{Binding WindowCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Run Text="ventanas" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
