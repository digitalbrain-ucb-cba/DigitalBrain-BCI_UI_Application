<UserControl x:Class="DigitalBrain.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DigitalBrain.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             d:DesignWidth="1400" d:DesignHeight="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,36,40,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado con chips de estado -->
            <DockPanel Grid.Row="0">
                <!-- Bloque derecho: chips de estado -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <!-- Chip 1: Casco EEG -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="14,7" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource StatusActiveBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Casco EEG conectado" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Chip 2: Modelo -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="14,7" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource StatusIdleBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.IsModelReady}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusActiveBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Modelo cargado" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.IsModelReady}" Value="False">
                                                <Setter Property="Text" Value="Modelo pendiente" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Chip 3: Robot UGOT -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource StatusActiveBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Robot UGOT conectado" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Título y subtítulo -->
                <StackPanel>
                    <TextBlock Text="PANEL PRINCIPAL" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="DigitalBrain EEG Suite" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,4" />
                    <TextBlock Text="Captura, clasificación y predicción de señales EEG con Machine Learning para mover el robot UGOT."
                               FontSize="16.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </DockPanel>

            <!-- Fila de Indicadores Clave (4 canales, 125 Hz configurable, 16 características, estado del dispositivo, modelo activo) -->
            <Grid Grid.Row="1" Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Canales Activos -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Channel1Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="CANALES ACTIVOS" Style="{StaticResource TileLabelStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveChannelsText}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ActiveChannelsDetail}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 2. Frecuencia de Muestreo (Editable globalmente) -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="EDITABLE" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="FRECUENCIA MUESTREO" Style="{StaticResource TileLabelStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="Hz" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding SampleRateInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource DisplayFont}"
                                     FontSize="24"
                                     FontWeight="Bold"
                                     Height="42"
                                     MinHeight="42"
                                     Padding="10,0"
                                     ToolTip="Escribe la frecuencia de muestreo en Hz (ej. 125, 250, 500). El cambio actualiza el ventaneo y los cálculos en todo el sistema." />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource LinkButtonStyle}" Content="125" Command="{Binding SetPresetSampleRateCommand}" CommandParameter="125"
                                    FontSize="12" Margin="0,0,10,0" ToolTip="Frecuencia estándar 125 Hz" />
                            <Button Style="{StaticResource LinkButtonStyle}" Content="250" Command="{Binding SetPresetSampleRateCommand}" CommandParameter="250"
                                    FontSize="12" Margin="0,0,10,0" ToolTip="Frecuencia 250 Hz" />
                            <Button Style="{StaticResource LinkButtonStyle}" Content="500" Command="{Binding SetPresetSampleRateCommand}" CommandParameter="500"
                                    FontSize="12" ToolTip="Frecuencia 500 Hz" />
                        </StackPanel>
                        <TextBlock Text="{Binding SampleRateDetail}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 3. Características -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Channel4Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="CARACTERÍSTICAS" Style="{StaticResource TileLabelStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FeaturesText}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding FeaturesDetail}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 4. Estado del Dispositivo -->
                <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource StatusActiveBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="ESTADO DISPOSITIVO" Style="{StaticResource TileLabelStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DeviceStatusText}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding DeviceStatusDetail}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 5. Modelo Activo -->
                <Border Grid.Column="8" Style="{StaticResource CardStyle}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource StatusIdleBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.IsModelReady}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusActiveBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="MODELO ACTIVO" Style="{StaticResource TileLabelStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModelStatusText}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ModelStatusDetail}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Fila de los 3 Pasos del Flujo de Trabajo (Capturar, Entrenar, Controlar) -->
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tarjeta 1: Capturar señales -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="26,24">
                    <DockPanel LastChildFill="True">
                        <!-- Botón inferior -->
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource OutlineButtonStyle}" Command="{Binding NavigateCaptureCommand}"
                                Margin="0,20,0,0" HorizontalAlignment="Stretch">
                            <TextBlock Text="Nueva captura" />
                        </Button>

                        <!-- Barra de sub-información -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="ConDumpAuto.exe" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecordingsSummary}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <!-- Cabecera de la tarjeta: Badge 1 y estado Hecho -->
                        <DockPanel DockPanel.Dock="Top">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource TileBackgroundBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource StatusActiveBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Hecho" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource SectionLabelBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </DockPanel>

                        <!-- Textos principales -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Capturar señales" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Ponte el casco EEG y graba varias repeticiones de cada movimiento." FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="22" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tarjeta 2: Entrenar el modelo -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="26,24">
                    <DockPanel LastChildFill="True">
                        <!-- Botón inferior: redirige a la pestaña Entrenar -->
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource OutlineButtonStyle}" Command="{Binding NavigateTrainingCommand}"
                                Margin="0,20,0,0" HorizontalAlignment="Stretch">
                            <TextBlock Text="Volver a entrenar" />
                        </Button>

                        <!-- Barra de sub-información -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="training.py" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Acierta 97 de cada 100 pruebas" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <!-- Cabecera de la tarjeta: Badge 2 y estado Hecho -->
                        <DockPanel DockPanel.Dock="Top">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource TileBackgroundBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource StatusActiveBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Hecho" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource SectionLabelBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </DockPanel>

                        <!-- Textos principales -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Entrenar el modelo" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="El sistema aprende a diferenciar tus movimientos usando las grabaciones." FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="22" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tarjeta 3: Controlar el robot -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="26,24">
                    <DockPanel LastChildFill="True">
                        <!-- Botón inferior: redirige a Tiempo real -->
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NavigateRealtimeCommand}"
                                Margin="0,20,0,0" HorizontalAlignment="Stretch">
                            <TextBlock Text="Empezar ahora" />
                        </Button>

                        <!-- Barra de sub-información -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="realtime.py" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Casco, modelo y robot listos" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <!-- Cabecera de la tarjeta: Badge 3 y estado Siguiente paso -->
                        <DockPanel DockPanel.Dock="Top">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource TileBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Siguiente paso" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </DockPanel>

                        <!-- Textos principales -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Controlar el robot" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Imagina o ejecuta el movimiento y el robot UGOT se desplaza en tiempo real." FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="22" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
